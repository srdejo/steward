{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@steward/domain": ["../packages/domain/src/index.ts"],
      "@steward/domain/demo": ["../packages/domain/src/demo/index.ts"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "../packages/domain/src/**/*.ts"],
  "exclude": ["node_modules", "../packages/domain/src/**/*.test.ts"]
}
